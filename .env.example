# Host-side Nebius defaults. Override as needed.
IMAGE=va-voxel-poleline:v6.2-three-stage
HOST_OUTPUTS=/workspace/voxel_poleline/outputs
HOST_RAW_INPUT_DIR=/data/voxel_csv_combined

# Container-side experiment roots.
WORK_DIR=/outputs/poleline_voxel_run_session_groups
RAW_INPUT_DIR=/data/voxel_csv_combined

# Optional Stage-3 resume when using the all-stage launcher.
RESUME_STAGE3=0
